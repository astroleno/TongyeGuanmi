{
  "name": "@tongye-guanmi/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/verify-release-build.mjs && node scripts/verify-performance-budgets.mjs && node scripts/create-release-manifest.mjs",
    "build:release": "R5_REQUIRE_RELEASE_IDENTITY=1 pnpm run build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "playwright test e2e/smoke.spec.ts",
    "test:e2e": "playwright test",
    "test:release": "pnpm build && playwright test --config playwright.release.config.ts",
    "evidence:visual": "node scripts/capture-r5-visual-evidence.mjs",
    "evidence:memory": "node scripts/profile-r5-process-memory.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.13.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "xstate": "^5.19.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@playwright/test": "^1.53.2",
    "@types/node": "^24.0.8",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.30.1",
    "globals": "^15.15.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
