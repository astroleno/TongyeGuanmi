{
  "name": "@tongye-guanmi/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && pnpm run verify:media && node scripts/verify-release-build.mjs && node scripts/verify-performance-budgets.mjs && node scripts/create-cdn-publish-manifest.mjs && node scripts/create-release-manifest.mjs",
    "build:release": "pnpm run release:prepare && pnpm run evidence:memory:release && pnpm run release:finalize",
    "release:prepare": "R5_REQUIRE_RELEASE_IDENTITY=1 R5_REQUIRE_CDN=1 R5_RELEASE_MANIFEST_PHASE=prepare pnpm run build",
    "release:finalize": "R5_REQUIRE_RELEASE_IDENTITY=1 R5_REQUIRE_MEMORY_EVIDENCE=1 R5_RELEASE_MANIFEST_PHASE=finalize node scripts/create-release-manifest.mjs",
    "release:package": "node scripts/package-cdn-release.mjs",
    "release:verify-cdn": "node scripts/verify-cdn-release.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "playwright test e2e/smoke.spec.ts",
    "test:e2e": "playwright test",
    "test:release": "pnpm build && playwright test --config playwright.release.config.ts",
    "verify:media": "node scripts/verify-homepage-media-inventory.mjs",
    "verify:media:deep": "node scripts/verify-homepage-media-deep.mjs",
    "rebuild:media:crane": "node scripts/rebuild-crane-figure-media.mjs",
    "rebuild:media:crane-flock": "node scripts/rebuild-crane-flock-media.mjs",
    "rebuild:media:crane-flock-poster": "node scripts/rebuild-crane-flock-poster.mjs",
    "rebuild:media:figure2-depth-mask": "node scripts/rebuild-figure2-depth-mask-atlas.mjs",
    "evidence:visual": "node scripts/capture-r5-visual-evidence.mjs",
    "evidence:memory": "node scripts/profile-r5-process-memory.mjs",
    "evidence:memory:release": "node scripts/run-r5-process-memory.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.13.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "xstate": "^5.19.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@playwright/test": "^1.53.2",
    "@types/node": "^24.0.8",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.30.1",
    "globals": "^15.15.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
