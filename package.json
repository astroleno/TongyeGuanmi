{
  "name": "tongye-guanmii-uniapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "uni -p mp-weixin",
    "dev:web": "node scripts/serve-static-site.mjs",
    "dev:h5": "uni -p h5",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:h5": "uni build -p h5",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:mp-weixin:release": "TONGYE_RELEASE=1 node scripts/check-release-mode.mjs && uni build -p mp-weixin",
    "typecheck": "vue-tsc --noEmit",
    "check:release": "node scripts/check-release-mode.mjs",
    "check:secrets": "rg -n \"webhook|\\\\btoken\\\\b|secret|corpsecret|Authorization\" src || true"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-1000920260525813",
    "@dcloudio/uni-components": "3.0.0-alpha-1000920260525813",
    "@dcloudio/uni-h5": "3.0.0-alpha-1000920260525813",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-1000920260525813",
    "vue": "3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-1000920260525813",
    "sass": "^1.93.3",
    "typescript": "~5.4.5",
    "vite": "8.0.13",
    "vue-tsc": "^2.2.12"
  }
}
